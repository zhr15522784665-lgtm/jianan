root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[cloudfunctions/chat/safety-router.js]
end_of_line = unset

[miniprogram/pages/ocd-assess/assess-items.js]
end_of_line = unset
