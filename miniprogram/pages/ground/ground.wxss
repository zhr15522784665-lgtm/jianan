/* pages/ground/ground.wxss */
.ground {
  padding: 32rpx 0 64rpx;
  animation: fadeUp 0.4s ease both;
}
.intro {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.step {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(14, 148, 136, 0.05);
  animation: fadeUp 0.5s ease both;
}
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.step-head {
  display: flex;
  align-items: center;
}
.step-num {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: var(--teal);
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 800;
}
.step-sense {
  font-size: 30rpx;
  font-weight: 700;
  margin-left: 18rpx;
  color: var(--ink);
}
.step-check {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);
  padding: 8rpx 18rpx;
  border-radius: 28rpx;
}
.step-check.on {
  color: #fff;
  background: var(--teal);
  border-color: var(--teal);
}
.step-hint {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin: 14rpx 0;
}
.step-input {
  background: var(--bg);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--teal-dark);
  margin-top: 24rpx;
}
