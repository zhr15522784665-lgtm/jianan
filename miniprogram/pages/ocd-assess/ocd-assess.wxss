.page {
  padding: 40rpx 28rpx;
  color: #203330;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.intro,
.question,
.next,
.disclaimer {
  line-height: 1.7;
  margin: 24rpx 0;
}
.question {
  font-size: 34rpx;
  font-weight: 600;
}
.progress {
  color: #0e9488;
}
.options button {
  margin: 16rpx 0;
  background: #fff;
  border: 2rpx solid #d7e6e2;
}
.options .selected {
  background: #dff3ef;
  border-color: #0e9488;
}
.consent {
  display: block;
  margin: 24rpx 0;
}
.nav {
  display: flex;
  gap: 20rpx;
}
.nav button {
  flex: 1;
}
.result {
  text-align: center;
  background: #f2faf8;
  padding: 40rpx;
  border-radius: 24rpx;
}
.result-band {
  font-size: 56rpx;
  color: #0e9488;
  font-weight: 700;
}
.saving {
  color: #0e9488;
  margin-top: 20rpx;
}
.error {
  color: #b4442f;
  margin-top: 20rpx;
}
