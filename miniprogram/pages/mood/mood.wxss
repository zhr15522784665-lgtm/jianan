/* pages/mood/mood.wxss */
.mood {
  padding: 40rpx 0 60rpx;
}

.mood-head {
  text-align: center;
  margin-bottom: 36rpx;
  animation: fadeUp 0.4s ease both;
}
.mood-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--teal);
}
.mood-sub {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 10rpx;
}

.week {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(14, 148, 136, 0.06);
  animation: fadeUp 0.5s ease both;
}
.week-cell {
  flex: 1;
  text-align: center;
}
.week-emoji {
  font-size: 44rpx;
  height: 56rpx;
  line-height: 56rpx;
}
.week-emoji.empty {
  color: #cdd8d6;
}
.week-label {
  font-size: 20rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

/* 今日一句 */
.prompt-card {
  background: linear-gradient(135deg, var(--teal-soft), #f3f7f6);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  animation: fadeUp 0.45s ease both;
}
.prompt-label {
  font-size: 22rpx;
  color: var(--teal);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.prompt-text {
  font-size: 30rpx;
  color: var(--ink);
  margin-top: 12rpx;
  line-height: 1.7;
  font-weight: 600;
}

/* 近 14 天趋势 */
.trend {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(14, 148, 136, 0.06);
  animation: fadeUp 0.5s ease both;
}
.trend-title {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 20rpx;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 180rpx;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.trend-bar-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  width: 60%;
}
.trend-bar {
  width: 100%;
  min-height: 6rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #e1ebe9;
  transition: height 0.3s ease;
}
.trend-bar.on {
  background: linear-gradient(180deg, var(--teal), #7fc9bf);
}
.trend-d {
  font-size: 16rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  transform: scale(0.9);
}

/* 当月心情日历 */
.cal {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 6rpx 24rpx rgba(14, 148, 136, 0.06);
  animation: fadeUp 0.55s ease both;
}
.cal-title {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 18rpx;
}
.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-soft);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.28%;
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cal-cell.blank {
  visibility: hidden;
}
.cal-emoji {
  font-size: 36rpx;
  line-height: 1;
}
.cal-day {
  font-size: 18rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
}

.mood-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--teal);
  font-weight: 600;
  margin-top: 22rpx;
  text-decoration: underline;
}

.choose-tip {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
.mood-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14rpx;
  margin-bottom: 36rpx;
}
.mood-opt {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(14, 148, 136, 0.05);
}
.mood-opt.on {
  border-color: var(--teal);
  background: var(--teal-soft);
}
.mood-opt-emoji {
  font-size: 52rpx;
}
.mood-opt-key {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 6rpx;
}

.note-wrap {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(14, 148, 136, 0.05);
}
.note {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.save-btn {
  height: 92rpx;
  border-radius: 46rpx;
  background: var(--teal);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-btn.saved {
  background: var(--teal-dark);
}

.mood-done {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--teal-dark);
  background: var(--teal-soft);
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 20rpx;
  animation: fadeUp 0.4s ease both;
}

.mood-foot {
  font-size: 22rpx;
  color: var(--ink-soft);
  text-align: center;
  margin-top: 28rpx;
  line-height: 1.7;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
