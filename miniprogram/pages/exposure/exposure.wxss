.page {
  padding: 32rpx 28rpx;
  color: #203330;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
}
.hint,
.section {
  margin: 20rpx 0;
  line-height: 1.6;
  color: #56706b;
}
.card,
.step {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin: 18rpx 0;
}
.add input,
.add textarea {
  box-sizing: border-box;
  width: 100%;
  margin: 12rpx 0;
  padding: 18rpx;
  background: #f4f8f7;
  border-radius: 14rpx;
}
.add textarea {
  height: 120rpx;
}
.step-title {
  font-size: 30rpx;
  font-weight: 600;
}
.step-meta,
.history-row {
  font-size: 23rpx;
  color: #6b817d;
  margin-top: 8rpx;
}
.running {
  text-align: center;
}
.timer {
  font-size: 72rpx;
  color: #0e9488;
  font-weight: 700;
  margin: 24rpx;
}
.error {
  color: #b4442f;
  margin-top: 20rpx;
}
