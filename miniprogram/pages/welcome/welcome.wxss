/* pages/welcome/welcome.wxss */
.welcome {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e8f5f3 0%, #f3f7f6 58%, #ffffff 100%);
  box-sizing: border-box;
}
.w-logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(14, 148, 136, 0.2);
  background: linear-gradient(135deg, #0e9488, #14b8a6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 112rpx;
  line-height: 1;
  animation: fadeUp 0.6s ease both;
}
.w-name {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--teal-dark);
  margin-top: 28rpx;
  letter-spacing: 12rpx;
  animation: fadeUp 0.7s ease both;
}
.w-slogan {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
  animation: fadeUp 0.8s ease both;
}
.w-enter {
  margin-top: 70rpx;
  padding: 18rpx 60rpx;
  background: var(--teal);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(14, 148, 136, 0.25);
  animation: fadeUp 0.9s ease both;
}
.w-enter-hover {
  opacity: 0.85;
}
