/* pages/breathe/breathe.wxss */
.breathe {
  padding: 48rpx 0;
  text-align: center;
  animation: fadeUp 0.4s ease both;
}
.tip {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  padding: 0 24rpx;
}

.patterns {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin: 28rpx 0 8rpx;
}
.pattern {
  font-size: 24rpx;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);
}
.pattern.on {
  background: var(--teal);
  color: #fff;
  border-color: var(--teal);
}

.stage {
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 0;
}
.circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #5cc5b8, var(--teal));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(14, 148, 136, 0.25);
  transform: scale(1);
}
.circle.ready {
  transform: scale(1);
}
.circle.inhale {
  transform: scale(1.7);
}
.circle.hold {
  transform: scale(1.7);
}
.circle.exhale {
  transform: scale(1);
}
.circle.hold2 {
  transform: scale(1);
}

.circle-inner {
  color: #fff;
  text-align: center;
}
.phase-label {
  font-size: 32rpx;
  font-weight: 700;
}
.count {
  font-size: 48rpx;
  font-weight: 800;
  margin-top: 4rpx;
}

.rounds {
  font-size: 26rpx;
  color: var(--teal-dark);
  font-weight: 600;
  margin-bottom: 32rpx;
}
.ctrl {
  padding: 0 80rpx;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
