# ============================================================
# 见岸 · 环境变量示例
# ------------------------------------------------------------
# 用法：复制本文件为 .env，把占位值换成你自己的真实 Key。
#   cp .env.example .env
#
# 安全约定：
#   · .env 已被 .gitignore 排除，永远不会进仓库
#   · 真实 Key 只写在 .env（或云端环境变量），不要写回本文件
# ============================================================

# ---------- 主链路：大模型（OpenAI 兼容协议） ----------
# 本项目只依赖「OpenAI 兼容」这一协议，不绑定具体厂商。
# 换服务商时只需改下面三行，代码无需改动。
#
# 默认给的是 DeepSeek 官方直连（便宜、响应快，适合高频陪伴对话）。
# 若使用其他兼容服务（自建代理、企业网关等），把 BASE_URL 与 MODEL 换成对应值即可。
#
# 注意：变量名沿用 DEEPSEEK_* 属历史命名，实际可指向任意 OpenAI 兼容服务，
#      不要被名字误导。
DEEPSEEK_API_KEY=<填入你的 API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 思考模式强度：none | low | high | max
#   none = 关闭思考链。心理陪伴场景推荐：更快、更省，回复更简短自然
#   留空 = 由服务端默认（通常 high，会先输出大段思维链，慢且贵）
DEEPSEEK_REASONING_EFFORT=none

# ---------- 安全与体验开关（三档：off / shadow / on） ----------
# 首次部署建议先用 shadow 观察一周日志，确认无误再切 on。

# OCD 安全分诊：off=旧规则；shadow=只对比不改变体验；on=启用四级分流
# on 模式下，侵入性思维（伤害/自伤类强迫观念）不会被误判为真实危机
SAFETY_ROUTER_V2_MODE=shadow

# 情绪标签（驱动前端三态表情）
#   off    = 不请求结构化输出，回包不含 emotion（与旧合同逐字一致）
#   shadow = 计算标签并回包，前端不渲染（先看日志）
#   on     = 全链路生效，前端渲染情绪态
# 实现说明：规则快通道 + 模型同次结构化输出，不额外增加一次调用；
#          解析失败自动回落纯文本，对话不中断。
EMOTION_LABEL_MODE=shadow

# OCD 专精路由：off=兼容旧链路；shadow=计算但不影响体验；on=启用专精提示与路由
OCD_ROUTER_MODE=shadow

# 重复寻求保证时呈现「两分钟不确定性暂停」；0 关闭，其他值开启
UNCERTAINTY_PAUSE_ENABLED=1

# ---------- 兜底链路（可选） ----------
# 主链路失败时自动降级的备用 OpenAI 兼容服务。
# 留空即禁用兜底，只走主链路。变量名沿用历史命名。
AIPING_API_KEY=
AIPING_BASE_URL=
# 可选：强制所有人格使用同一个备用模型；留空沿用人格配置
AIPING_MODEL=

# ============================================================
# 云函数部署说明（重要）
# ------------------------------------------------------------
# 部署只打包 cloudfunctions/<函数名>/ 目录本身，项目根目录的 .env 不会跟着上去。
# 云端读不到 Key 会返回 NO_KEY_DEEPSEEK 错误。
#
# 配置 Key 的三种方式（任选其一）：
#
#   ① 复制到函数目录（最省事）
#        cp .env cloudfunctions/chat/.env
#      部署时随函数目录一起上传，env-loader 会从同目录读取。
#
#   ② 云开发控制台配置（Key 不落盘，最规范）
#      云开发控制台 → 云函数 → chat → 函数配置 → 环境变量
#      添加 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
#
#   ③ cloudbaserc.json 的 functions[].envVariables
#      仅 CloudBase CLI 部署生效；开发者工具右键部署不读它。
#
# 优先级：非空控制台环境变量 > 函数目录 .env（缺失或空字符串会从文件补齐）
#   → 控制台若残留旧配置，会覆盖函数目录的 .env，换服务商时务必同步更新
# ============================================================
